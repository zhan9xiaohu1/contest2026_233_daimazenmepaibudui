include $(TOPDIR)/.config
include $(TOPDIR)/tools/Config.mk

# SiFli SF32LB52 HAL include paths (must be before Toolchain.defs)
CHIPSIFLIDIR = $(TOPDIR)/../vendor/sifli/chips
INCLUDES += ${INCDIR_PREFIX}$(CHIPSIFLIDIR)/drivers/Include
INCLUDES += ${INCDIR_PREFIX}$(CHIPSIFLIDIR)/drivers/cmsis/Include
INCLUDES += ${INCDIR_PREFIX}$(CHIPSIFLIDIR)/drivers/cmsis/sf32lb52x
INCLUDES += ${INCDIR_PREFIX}$(CHIPSIFLIDIR)/external/CMSIS/Include
INCLUDES += ${INCDIR_PREFIX}$(CHIPSIFLIDIR)/boards/include/config/sf32lb52x

# SF32LB52 uses Cortex-M33 (ARMv8-M), use armv8-m toolchain

include $(TOPDIR)/arch/arm/src/armv8-m/Toolchain.defs

ARCHSCRIPT += $(BOARD_DIR)$(DELIM)scripts$(DELIM)ld.script

ARCHPICFLAGS = -fpic

CFLAGS := $(ARCHCFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS) -pipe -Werror=return-type -Werror -w -I$(CHIPSIFLIDIR)/drivers/Include -I$(CHIPSIFLIDIR)/drivers/cmsis/Include -I$(CHIPSIFLIDIR)/drivers/cmsis/sf32lb52x -I$(CHIPSIFLIDIR)/external/CMSIS/Include -I$(CHIPSIFLIDIR)/boards/include/config/sf32lb52x -I$(CHIPSIFLIDIR)/sf32lb52/include -I$(BOARD_DIR)/include -DSOC_BF0_HCPU -DSF32LB52X -DHAL_TICK_PER_SECOND=1000 -DUSE_HAL_DRIVER
CPICFLAGS = $(ARCHPICFLAGS) $(CFLAGS)
CXXFLAGS := $(ARCHCXXFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHXXINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS) -pipe
CXXPICFLAGS = $(ARCHPICFLAGS) $(CXXFLAGS)
CPPFLAGS := $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
AFLAGS := $(CFLAGS) -D__ASSEMBLY__

EXTRA_LIBS += $(wildcard $(shell readlink -f $(TOPDIR)/$(CONFIG_ARCH_BOARD_CUSTOM_DIR)/libs/$(CONFIG_ARCH_BOARD_CUSTOM_NAME))/*.a)
