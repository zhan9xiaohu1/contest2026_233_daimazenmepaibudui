 /****************************************************************************
  * Name:  sf32lb_lcd_setcontrast
  *
  * Description:
- *   Set LCD panel contrast (0-CONFIG_LCD_MAXCONTRAST).
+ *   设亮度百分比（0..100），转发给面板驱动的 SetBrightness 回调 —— CO5300 的
+ *   LCD_SetBrightness() 把百分比换算成 0..255 写 0x51 WBRIGHT。
+ *
+ *   别的屏可能没实现这个可选回调，那时如实回 -ENOSYS，不空指针调用。
  *
  ****************************************************************************/
 
 static int sf32lb_lcd_setcontrast(FAR struct lcd_dev_s *dev,
                               unsigned int contrast)
 {
-  lcdinfo("contrast: %d\n", contrast);
-  return -ENOSYS;
+  FAR struct sf32lb_lcd_dev_s *priv = (FAR struct sf32lb_lcd_dev_s *)dev;
+
+  lcdinfo("contrast(brightness): %u\n", contrast);
+
+  if (contrast > SF32LB_LCD_BRIGHTNESS_MAX)
+    {
+      lcderr("contrast %u out of range 0..%d\n",
+             contrast, SF32LB_LCD_BRIGHTNESS_MAX);
+      return -EINVAL;
+    }
+
+  if (priv->p_drv_ops == NULL || priv->p_drv_ops->p_ops == NULL ||
+      priv->p_drv_ops->p_ops->SetBrightness == NULL)
+    {
+      lcdinfo("SetBrightness() not implemented by this panel\n");
+      return -ENOSYS;
+    }
+
+  priv->p_drv_ops->p_ops->SetBrightness(&priv->hlcdc, (uint8_t)contrast);
+
+  priv->contrast = (int)contrast;
+
+  return OK;
 }
 
                               
